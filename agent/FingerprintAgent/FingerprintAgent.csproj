<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = tidak ada jendela terminal/console yang muncul saat dijalankan -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FingerprintAgent</AssemblyName>
    <RootNamespace>FingerprintAgent</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Icon file .exe itu sendiri (yang tampil di Explorer/Task Manager) -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="libzkfpcsharp">
      <HintPath>lib\libzkfpcsharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Dipakai untuk system tray icon (NotifyIcon) & MessageBox error -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
