ARB_URL=http://127.0.0.1:8000

# Akun sistem buat Agent login ke ARB+ (progId MADC0005) — bukan akun user
# asli, 1 kredensial yang disiapkan khusus buat Agent, sama konvensinya
# seperti ARB_SYSTEM_USERNAME/PASSWORD di sistem lain yang terhubung ke ARB+.
ARB_USERNAME=
ARB_PASSWORD=

# Opsional — ganti kalau port 9001 bentrok di laptop ini (lihat README,
# bagian troubleshooting "Access is denied").
AGENT_PORT=9001
